import java.math.BigDecimal;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Objects;

public class Order {
    private final String id;
    private final String customerId;
    private final LocalDate date;
    private final List<OrderItem> lines = new ArrayList<>();

    private boolean confirmed;
    private boolean cancelled;
    private BigDecimal paidTotal = BigDecimal.ZERO;

    public Order(String id, String customerId) {
        this(id, customerId, LocalDate.now());
    }

    public Order(String id, String customerId, LocalDate date) {
        if (id == null || id.trim().isEmpty()) {
            throw new IllegalArgumentException("Mã đơn hàng không được rỗng");
        }
        if (customerId == null || customerId.trim().isEmpty()) {
            throw new IllegalArgumentException("Mã khách hàng không được rỗng");
        }
        if (date == null) {
            throw new IllegalArgumentException("Ngày lập đơn không được rỗng");
        }

        this.id = id.trim();
        this.customerId = customerId.trim();
        this.date = date;
    }

    public String getId() {
        return id;
    }

    public String getCustomerId() {
        return customerId;
    }

    public LocalDate getDate() {
        return date;
    }

    public boolean isConfirmed() {
        return confirmed;
    }

    public boolean isCancelled() {
        return cancelled;
    }

    public BigDecimal getPaidTotal() {
        return paidTotal;
    }

    public List<OrderItem> getLines() {
        return Collections.unmodifiableList(new ArrayList<>(lines));
    }

    private void checkEditable() {
        if (confirmed || cancelled) {
            throw new IllegalStateException(
                    "Không thể sửa đơn đã xác nhận hoặc đã hủy");
        }
    }

    public void addItem(Product product, int quantity) {
        checkEditable();
        lines.add(new OrderItem(product, quantity));
    }

    public void removeItem(int index) {
        checkEditable();

        if (index < 0 || index >= lines.size()) {
            throw new IllegalArgumentException("Dòng hàng không tồn tại");
        }
        lines.remove(index);
    }

    public BigDecimal total() {
        BigDecimal sum = BigDecimal.ZERO;

        for (OrderItem item : lines) {
            sum = sum.add(item.subtotal());
        }
        return sum;
    }

    public void confirm(DiscountStrategy strategy) {
        checkEditable();

        if (lines.isEmpty()) {
            throw new IllegalStateException("Đơn hàng chưa có sản phẩm");
        }
        if (strategy == null) {
            throw new IllegalArgumentException("Chưa chọn cách giảm giá");
        }

        BigDecimal originalTotal = total();
        BigDecimal result = strategy.apply(originalTotal);

        if (result == null || result.signum() < 0
                || result.compareTo(originalTotal) > 0) {
            throw new IllegalArgumentException(
                    "Số tiền sau giảm giá không hợp lệ");
        }

        paidTotal = result;
        confirmed = true;
    }

    public void cancel() {
        if (cancelled) {
            throw new IllegalStateException("Đơn hàng đã bị hủy");
        }
        cancelled = true;
    }

    @Override
    public String toString() {
        String status;

        if (cancelled) {
            status = "Đã hủy";
        } else if (confirmed) {
            status = "Đã xác nhận";
        } else {
            status = "Đang lập";
        }

        return id + " | khách: " + customerId + " | ngày: " + date
                + " | tổng trước giảm: " + total()
                + " | " + status;
    }

    @Override
    public boolean equals(Object object) {
        if (this == object) {
            return true;
        }
        if (!(object instanceof Order)) {
            return false;
        }

        Order other = (Order) object;
        return id.equals(other.id);
    }

    @Override
    public int hashCode() {
        return Objects.hash(id);
    }
}
