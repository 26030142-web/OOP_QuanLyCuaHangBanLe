import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

class InsufficientStockException extends RuntimeException {
    public InsufficientStockException(String productId) {
        super("Không đủ tồn kho cho sản phẩm: " + productId);
    }
}

public class OrderService {
    private final List<Order> orders = new ArrayList<>();
    private final ProductManager products;
    private final CustomerManager customers;

    public OrderService(ProductManager products, CustomerManager customers) {
        if (products == null || customers == null) {
            throw new IllegalArgumentException(
                    "Danh mục sản phẩm và khách hàng không được rỗng");
        }
        this.products = products;
        this.customers = customers;
    }

    public Order create(String id, String customerId) {
        Order order = new Order(id, customerId);

        Customer customer = customers.findById(order.getCustomerId());
        if (!customer.isActive()) {
            throw new IllegalArgumentException(
                    "Khách hàng đã ngừng hoạt động");
        }

        for (Order current : orders) {
            if (current.getId().equals(order.getId())) {
                throw new IllegalArgumentException(
                        "Mã đơn hàng đã tồn tại: " + order.getId());
            }
        }

        orders.add(order);
        return order;
    }

    public Order find(String id) {
        for (Order order : orders) {
            if (order.getId().equals(id)) {
                return order;
            }
        }
        throw new IllegalArgumentException(
                "Không tìm thấy đơn hàng có mã: " + id);
    }

    public void addItem(String orderId, String productId, int quantity) {
        Order order = find(orderId);
        Product product = products.findById(productId);

        if (!product.isActive()) {
            throw new IllegalArgumentException("Sản phẩm đã ngừng bán");
        }
        order.addItem(product, quantity);
    }

    public void removeItem(String orderId, int index) {
        find(orderId).removeItem(index);
    }

    public void confirm(String orderId, DiscountStrategy strategy) {
        Order order = find(orderId);

        if (order.isConfirmed() || order.isCancelled()) {
            throw new IllegalStateException(
                    "Đơn hàng đã xác nhận hoặc đã hủy");
        }

        Map<String, Integer> required = quantitiesIn(order);

        // Kiểm tra tất cả trước khi thay đổi tồn kho.
        for (Map.Entry<String, Integer> entry : required.entrySet()) {
            Product product = products.findById(entry.getKey());

            if (product.getStock() < entry.getValue()) {
                throw new InsufficientStockException(entry.getKey());
            }
        }

        order.confirm(strategy);

        for (Map.Entry<String, Integer> entry : required.entrySet()) {
            Product product = products.findById(entry.getKey());
            product.setStock(product.getStock() - entry.getValue());
        }
    }

    public void cancel(String orderId) {
        Order order = find(orderId);

        if (order.isCancelled()) {
            throw new IllegalStateException("Đơn hàng đã bị hủy");
        }

        Map<String, Integer> quantities = quantitiesIn(order);

        if (order.isConfirmed()) {
            // Kiểm tra trước để tránh hủy đơn rồi mới phát hiện lỗi.
            for (Map.Entry<String, Integer> entry : quantities.entrySet()) {
                Product product = products.findById(entry.getKey());
                Math.addExact(product.getStock(), entry.getValue());
            }
        }

        boolean returnToStock = order.isConfirmed();
        order.cancel();

        if (returnToStock) {
            for (Map.Entry<String, Integer> entry : quantities.entrySet()) {
                Product product = products.findById(entry.getKey());
                product.setStock(
                        product.getStock() + entry.getValue());
            }
        }
    }

    private Map<String, Integer> quantitiesIn(Order order) {
        Map<String, Integer> quantities = new HashMap<>();

        for (OrderItem item : order.getLines()) {
            String id = item.getProductId();
            int oldQuantity = quantities.containsKey(id)
                    ? quantities.get(id) : 0;

            quantities.put(
                    id, Math.addExact(oldQuantity, item.getQuantity()));
        }

        return quantities;
    }

    public List<Order> listAll() {
        return new ArrayList<>(orders);
    }
}
