import java.math.BigDecimal;
import java.util.Scanner;

public class InputHelper {

    public static String readNonBlank(Scanner scanner, String label) {
        while (true) {
            System.out.print(label);
            String value = scanner.nextLine().trim();

            if (!value.isEmpty()) {
                return value;
            }
            System.out.println("Không được để trống. Vui lòng nhập lại.");
        }
    }

    public static int readIntInRange(
            Scanner scanner, String label, int min, int max) {
        while (true) {
            System.out.print(label);
            String value = scanner.nextLine().trim();

            try {
                int number = Integer.parseInt(value);
                if (number >= min && number <= max) {
                    return number;
                }
            } catch (NumberFormatException e) {
                // Thông báo chung ở bên dưới.
            }

            System.out.println(
                    "Vui lòng nhập số nguyên từ " + min + " đến " + max + ".");
        }
    }

    public static int readPositiveInt(Scanner scanner, String label) {
        while (true) {
            System.out.print(label);
            String value = scanner.nextLine().trim();

            try {
                int number = Integer.parseInt(value);
                if (number > 0) {
                    return number;
                }
            } catch (NumberFormatException e) {
                // Thông báo chung ở bên dưới.
            }

            System.out.println("Vui lòng nhập số nguyên lớn hơn 0.");
        }
    }

    public static BigDecimal readMoney(Scanner scanner, String label) {
        while (true) {
            System.out.print(label);
            String value = scanner.nextLine().trim();

            try {
                BigDecimal amount = new BigDecimal(value);
                if (amount.compareTo(BigDecimal.ZERO) > 0) {
                    return amount;
                }
            } catch (NumberFormatException e) {
                // Thông báo chung ở bên dưới.
            }

            System.out.println("Vui lòng nhập số tiền lớn hơn 0.");
        }
    }
}
